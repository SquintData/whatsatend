NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://whatsatend:CHANGE_ME@localhost:5432/whatsatend
# Used only by npm run provision; generate a different token for each channel.
COMPANY_NAME=Empresa de teste
WAHA_INSTANCE=principal
WAHA_SESSION=teste
WEBHOOK_TOKEN=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS

# Global kill switch; channel scope is configured separately with channel:scope.
AUTO_REPLY_ENABLED=false
# Optional legacy values for the old single-chat pause/resume CLI only.
AUTO_REPLY_INSTANCE=
AUTO_REPLY_SESSION=
TEST_CHAT_ID=
WAHA_BASE_URL=http://atendimento-waha:3000
# This is the EXISTING WAHA API key, not WEBHOOK_TOKEN.
WAHA_API_KEY=

# Optional first AI provider. Keep the real key in the runtime environment only.
OPENAI_API_KEY=
