{
  "name": "whatsatend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "node --import tsx src/migrate.ts",
    "provision": "node --import tsx src/provision.ts",
    "company:admin": "node dist/company-admin.js",
    "ai:config": "node dist/ai-config.js",
    "channel:scope": "node dist/channel-scope.js",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": { "fastify": "^5.6.0", "pg": "^8.16.3", "zod": "^4.1.0" },
  "devDependencies": { "@electric-sql/pglite": "^0.3.14", "@types/node": "^22.18.0", "@types/pg": "^8.15.5", "tsx": "^4.20.5", "typescript": "^5.9.2" }
}
